  "tokenColors": [
    {
      "scope": [
        ""
      ],
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6C7A9C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.export",
        "storage.type",
        "storage.modifier",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#B8A0FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method",
        "meta.method-call.js",
        "support.function.misc",
        "keyword.other.special-method",
        "entity.name.function.python"
      ],
      "settings": {
        "foreground": "#7FC3FF"
      }
    },
    {
