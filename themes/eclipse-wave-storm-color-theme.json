  "tokenColors": [
    {
      "scope": [
        ""
      ],
      "settings": {
        "foreground": "#E6EDF3"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8B949E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.export",
        "storage.type",
        "storage.modifier",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method",
        "meta.method-call.js",
        "support.function.misc",
        "keyword.other.special-method",
        "entity.name.function.python"
      ],
      "settings": {
        "foreground": "#D2A8FF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated",
        "string.regexp",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.numeric"
      ],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.object.property",
        "variable.other.object.property",
        "variable.other.constant",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class",
        "support.type",
        "meta.type.annotation",
        "entity.other.inherited-class"
