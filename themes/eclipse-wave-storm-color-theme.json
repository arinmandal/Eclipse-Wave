  "tokenColors": [
    {
      "scope": [
        ""
      ],
      "settings": {
        "foreground": "#B4C4DC"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#5A6A88",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.import",
        "keyword.other.export",
        "storage.type",
        "storage.modifier",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#7485E8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method",
        "meta.method-call.js",
        "support.function.misc",
        "keyword.other.special-method",
        "entity.name.function.python"
      ],
      "settings": {
        "foreground": "#68A8E0"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated",
        "string.regexp",
        "markup.inline.raw"
      ],
      "settings": {
