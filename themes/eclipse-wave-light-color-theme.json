    "number": {
      "foreground": "#954E10"
    },
    "operator": {
      "foreground": "#6A50B8"
    },
    "comment": {
      "foreground": "#7878A8",
      "italic": true
    },
    "macro": {
      "foreground": "#8B6400"
    },
    "*.mutable": {
      "underline": true
    },
    "*.async": {
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "italic": true
    },
    "*.abstract": {
      "italic": true
    }
